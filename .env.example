# Optional orchestrator timeouts and worktree retention.
# Copy to .env locally if you want to set these in the environment.
# Do not commit real secrets. This project does not require API keys in .env;
# workers authenticate through their own CLIs.

# AI_CURSOR_TIMEOUT_MS=300000
# AI_CODEX_TIMEOUT_MS=600000
# AI_GEMINI_TIMEOUT_MS=300000
# AI_TEST_TIMEOUT_MS=600000
# AI_WORKER_MAX_RETRIES=1
# AI_KEEP_SUCCESS_WORKTREES=false
# AI_KEEP_FAILED_WORKTREES=true
